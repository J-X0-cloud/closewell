# Anthropic API key used by the close agent (/api/agent)
ANTHROPIC_API_KEY=

# Model used by the agent loop
ANTHROPIC_MODEL=claude-opus-5

# Upper bound on agent tool-use turns per request
AGENT_MAX_TURNS=8

# Where demo requests are forwarded (optional; logged to the console when unset)
DEMO_WEBHOOK_URL=

# Public site URL, used for metadata
NEXT_PUBLIC_SITE_URL=https://closewell.com
